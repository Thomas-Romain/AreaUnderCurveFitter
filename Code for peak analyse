def ImportFile(File):
    try:
        if File.rsplit('.', 1)[1] == "csv":
            print("OK!")
            Data = np.genfromtxt(File, delimiter=',', skip_header = 1)
            if np.isnan(Data[0][0]) == True:
                print("Error!")
                try:
                    Data = np.genfromtxt(File, delimiter=',', skip_header = 1, usecols=(1,2),missing_values=0)
                except:
                    print("Error reading data")
        if File.rsplit('.',1)[1] == 'txt':
            Data = np.genfromtxt(rf"{File}")
        Temperature = Data[:,0]
    except Exception as e:
                     print(f"Error! {e}")
                     print("Running backup attempt...")
                     try:
                          Data = np.genfromtxt(File, delimiter=',', skip_header = 1, usecols=(1,2),missing_values=0)
