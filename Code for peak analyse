                                      Temperature = Data[:,0]
    return Data[:,1], Temperature

def BaseAdjust(Base1,Base2, Temperature,Data):
    if Base1 > Temperature[0] and Base2>Temperature[0]:
        print(Temperature[0])
        Data = Data[:,1]
        plt.axvline(Base1,color='black', lw=0.9)
        plt.axvline(Base2,color='black', lw=0.9)
        if Base1<Base2:
            Data = Data-np.mean(Data[np.where(Temperature >= Base1)[0]:np.where(Temperature >= Base2)[0]]) ####Adjusting 
        if Base1>Base2:
            Data = Data-np.mean(Data[np.where(Temperature >= Base2)[0]:np.where(Temperature >= Base1)[0]]) ####Adjusting      
        if Base1==Base2:
            Data = Data-np.mean(Data[0:10])
            print("Error with input 'Base', make sure Base1 < Base 2")
    else:
        Data = Data
        print("Error with baseline adjustment")
    plt.axvspan(Base1, Base2, alpha=0.2, lw=0, color = 'black')
    return Data

def CalcArea(Peak1,Peak2,Data,Temperature):
    try:
        AreaCalculated = simpson(Data[np.where(Temperature >= Peak1)[0][0]:np.where(Temperature >= Peak2)[0][0]], dx=5)   
    except Exception as e:
        print(f"Error! {e}")
        print("Value of limit 1 and limit 2 are equal. Avoid this if possible")
        AreaCalculated=0
    return AreaCalculated

